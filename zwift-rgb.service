[Unit]
Description=Zwift power-zone RGB (sniffs KICKR DirCon, drives OpenRGB)
After=network-online.target openrgb.service
Wants=network-online.target

[Service]
# Template: copy to zwift-rgb.local.service (gitignored), fill in, then
#   sudo cp zwift-rgb.local.service /etc/systemd/system/zwift-rgb.service
User=YOUR_USER
Environment=ZRGB_FTP=250
Environment=ZRGB_TRAINER=192.168.1.50
Environment=ZRGB_PROFILE=YourProfile
# Optional (see README for all settings):
#Environment=ZRGB_IFACE=eth0
#Environment="ZRGB_TINT=Addressable RGB Header 1=1,0.45,1"
#Environment=ZRGB_PULSE_RATIO=5
ExecStart=/usr/bin/python3 -I -u /home/YOUR_USER/git/zwift-rgb/zwift_rgb.py
# tcpdump needs raw capture; grant just that instead of running as root.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
